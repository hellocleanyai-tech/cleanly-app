# ============================================================================
# Cleanly AI environment variables
#
# Copy to .env for local development, and set the same keys in
# Netlify → Site settings → Environment variables for production.
#
# NEVER commit a real .env file.
# ============================================================================

# ----------------------------------------------------------------- PUBLIC --
# Injected into the browser bundle by scripts/build-config.mjs.
# The anon key is public by design and protected by Row Level Security.

SUPABASE_URL=https://hupeqzyrzrtwymdoogbn.supabase.co
SUPABASE_ANON_KEY=your-anon-key

LS_CHECKOUT_URL=https://cleanly-app.lemonsqueezy.com/checkout
LS_STARTER_TRIAL_URL=https://cleanly-app.lemonsqueezy.com/checkout/buy/951fa1d7-06ec-400a-b43e-fb3f0331d49a
LS_STARTER_STANDARD_URL=https://cleanly-app.lemonsqueezy.com/checkout/buy/b21dd36e-37ac-4a7a-86f1-88a57b94ec6d
SUPPORT_EMAIL=support@cleanly.ai

# ----------------------------------------------------------- SERVER ONLY --
# These are read only inside netlify/functions. They must never appear in any
# file under public/. The build script fails hard if one leaks.

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret

# ------------------------------------------------ PLAN MAPPING (optional) --
# Lemon Squeezy variant ids. Setting these makes plan detection independent of
# product naming. Find them in Lemon Squeezy → Products → Variant → ID.

LEMON_STARTER_VARIANT_ID=
LEMON_GROWTH_VARIANT_ID=
LEMON_PRO_VARIANT_ID=
